# Builds the way a service is expected to: copy a program in, set an exec-form
# ENTRYPOINT. There is no RUN step because the base image has no shell.

ARG BASE_IMAGE

FROM ${BASE_IMAGE}

COPY smoke.py /app/smoke.py

ENTRYPOINT [ "/usr/bin/python3.13", "/app/smoke.py" ]
